@article{ma2025SCES,
  title    = {Optimization of Key Land Surface Albedo Parameter Reduces Wet Bias of Climate Modeling for the {{Tibetan Plateau}}},
  author   = {Ma, Xiaogang and Zhao, Long and Sun, Jing and Chen, Jinyan and Wang, Yan and Zhou, Jianhong and Liu, Jiarui and Lu, Hui and Yang, Kun},
  year     = 2025,
  month    = aug,
  journal  = {Science China Earth Sciences},
  volume   = {68},
  number   = {8},
  pages    = {2653--2662},
  doi      = {10.1007/s11430-025-1635-0},
  abstract = {Land surface albedo plays a key role in regulating surface energy budgets and thereby land-atmosphere interactions. Most land surface models employ a so-called soil color parameter to determine albedos for dry/saturated soils, yet it is poorly characterized in the Weather Research and Forecasting (WRF) model, leading to an underestimation of summertime surface albedo on the Tibetan Plateau (TP). This study introduces an optimized soil color map, which can effectively enhance the simulation of surface albedo and land surface temperature over a 10-year climate modeling period. This improvement reduces the TP's thermal effect, along with decreased net radiation, latent, and sensible heat during the summer, leading to an increase in geopotential height in the lower troposphere and a reduction in water vapor flux convergence. The resulting precipitation estimation shows a reduced wet bias (52\% to 36\%), as compared with IMERG and GSMaP products. Further evaluation against rain-gauge observations suggests that the incorporation of an optimized soil color map improves precipitation simulation at 66\% of the stations, with mean wet bias mitigated from 1.02 to 0.82 mm d-1. The findings reveal that the underestimation of surface albedo is partially responsible for the wet bias in precipitation simulation. It also highlights the feasibility of improving climate modeling by optimizing land surface parameters, which is highly affordable through the joint use of land surface models and satellite remote sensing products.},
  langid   = {english},
}

@article{meng2018ERL,
  title    = {Simulated Cold Bias Being Improved by Using {{MODIS}} Time-Varying Albedo in the {{Tibetan Plateau}} in {{WRF}} Model},
  author   = {Meng, Xianhong and Lyu, S. and Zhang, T. and Zhao, L. and Li, Z. and Han, B. and Li, S. and Ma, D. and Chen, H. and Ao, Y. and Luo, S. and Shen, Y. and Guo, J. and Wen, L.},
